namespace LcmSix.HeightOrbits
open WeierstrassCurve Affine EllipticDuplication

/-- An integer pair represents an actual x-coordinate, without a primitive premise. -/
def RawRepresents {a b c : ℚ} (P : (curve a b c).Point) (p q : ℤ) : Prop :=
  ∃ r : ℚ, r≠0 ∧ (p : ℚ)=r*P.xRep 0 ∧ (q : ℚ)=r*P.xRep 1

/-- A checked nonzero projective quotient transports actual group doubling.
No gcd claim about the quotient scalar is needed. -/
theorem raw_step {a b c p q p' q' d : ℤ}
    {P : (curve a b c).Point} (hP : RawRepresents P p q) (hd : d≠0)
    (hf : HeightCertificates.F a b c p q=d*p')
    (hg : HeightCertificates.G a b c p q=d*q') : RawRepresents (P+P) p' q' := by
  obtain ⟨r,hr,hp,hq⟩ := hP
  obtain ⟨s,hs,hsf,hsg⟩ := quartic_xRep_double a b c P
  have hdq : (d : ℚ)≠0 := by exact_mod_cast hd
  have hff : F a b c p q=(d : ℚ)*p' := by rw [F_cast]; exact_mod_cast hf
  have hgg : G a b c p q=(d : ℚ)*q' := by rw [G_cast]; exact_mod_cast hg
  rw [hp,hq,F_homogeneous,hsf] at hff
  rw [hp,hq,G_homogeneous,hsg] at hgg
  refine ⟨r^4*s/d,div_ne_zero (mul_ne_zero (pow_ne_zero _ hr) hs) hdq,?_,?_⟩
  · calc
      (p' : ℚ) = ((d : ℚ)*p')/d := (mul_div_cancel_left₀ _ hdq).symm
      _ = (r^4*s/d)*(P+P).xRep 0 := by rw [← hff]; ring
  · calc
      (q' : ℚ) = ((d : ℚ)*q')/d := (mul_div_cancel_left₀ _ hdq).symm
      _ = (r^4*s/d)*(P+P).xRep 1 := by rw [← hgg]; ring

/-- A final primitive representative gives the actual group's naive height. -/
theorem naiveHeight_of_raw {a b c : ℚ} {P : (curve a b c).Point} {p q B : ℤ}
    (hP : RawRepresents P p q) (hc : IsCoprime p q) (hB : max |p| |q|=B) :
    naiveHeight P=Real.log (B : ℝ) := by
  let T : PrimitiveDynamics.Point := ⟨p,q,hc⟩
  have ht : Represents P T := hP
  rw [← height_eq_of_represents ht]
  change Real.log (max |(p : ℝ)| |(q : ℝ)|)=_
  rw [← Int.cast_abs,← Int.cast_abs,← Int.cast_max,hB]

